{
  "name": "orthostudent",
  "productName": "OrthoStudent",
  "version": "1.0.0",
  "description": "Suite de revision, de bilans a interpreter et de consultations simulees pour les etudiants en orthoptie",
  "author": "OrthoStudent",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder -mw",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "edt": "node scripts/fetch-edt.js",
    "audit": "node scripts/audit-donnees.js",
    "smoke": "electron scripts/smoke.js",
    "postinstall": "electron-builder install-app-deps",
    "repet": "electron scripts/repet-essai.js",
    "audit:cours": "node scripts/audit-cours.js",
    "atelier": "node scripts/atelier-essai.js",
    "saut": "electron scripts/saut-essai.js",
    "seances": "node scripts/edt-essai.js",
    "anki": "node scripts/anki-essai.js",
    "anki:ecran": "electron scripts/anki-ecran.js",
    "optique": "electron scripts/optique-essai.js",
    "lab": "node scripts/lab-essai.js",
    "lab:ecran": "electron scripts/lab-ecran.js"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.orthostudent.app",
    "productName": "OrthoStudent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "celcat.js",
      "anki.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  }
}
